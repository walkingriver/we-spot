{
  "name": "we-spot",
  "version": "0.9.10",
  "author": "Michael D. Callaghan",
  "homepage": "https://walkingriver.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration=production",
    "build:dev": "ng build --configuration=development",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "lint": "ng lint",
    "generate-decks": "node tools/deck-generator/generate.mjs",
    "icons": "pwa-asset-generator src/assets/symbols/eyes-155625.svg ./src/assets/icon -e -c -f -t png -m src/manifest.webmanifest -i src/index.html -o false -b 'transparent'",
    "splash": "pwa-asset-generator src/assets/symbols/eyes-155625.svg ./src/assets/splash -h -f -t png -m src/manifest.webmanifest -i src/index.html -o false -b 'transparent'",
    "resources": "npm run icons && npm run splash",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@ionic/angular": "^8.8.2",
    "ionicons": "^8.0.8",
    "random-seedable": "^1.0.8",
    "random-word-slugs": "^0.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^19.8.0",
    "@angular-eslint/eslint-plugin": "^19.8.0",
    "@angular-eslint/eslint-plugin-template": "^19.8.0",
    "@angular-eslint/schematics": "^19.8.0",
    "@angular-eslint/template-parser": "^19.8.0",
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^9.16.0",
    "@ionic/angular-toolkit": "^12.1.1",
    "@playwright/test": "^1.49.0",
    "angular-eslint": "^19.8.0",
    "eslint": "^9.16.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "pwa-asset-generator": "^6.0.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.0.8"
  }
}
